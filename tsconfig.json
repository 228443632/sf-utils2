{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "strict": true,
    "jsx": "preserve",
    "baseUrl": "./",
    "allowJs": true,
    "importHelpers": true,
    "removeComments": false,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./lib", // 指定输出目录
    "declarationDir": "./lib", // 指定生成声明文件存放目录
    "emitDeclarationOnly": true, // 只生成声明文件，而不会生成js文件
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "paths": {
      "@/*": ["src/*"],
      "+root/*": [""],
      "+libs/*": ["lib/*"],
      "sf-utils2/*": ["src/*"]
    }
  },
  //  "exclude": ["node_modules", "dist", "lib"],
  "include": ["src"]
}
