{
  "name": "sf-utils2",
  "version": "3.0.26",
  "author": "bianpengfei",
  "license": "MIT",
  "homepage": "http://8.133.185.32/fr/@bianpengfei-utils/v3/",
  "alias-name": "sfutils",
  "main": "lib/index.umd.js",
  "module": "lib/index.esm.js",
  "unpkg": "lib/index.umd.min.js",
  "jsdelivr": "lib/index.umd.min.js",
  "types": "./index.d.ts",
  "scripts": {
    "dev": "yarn link sf-utils2 && npm run build:init-entry && cross-env NODE_ENV=development rollup -c build/rollup.dev.js -w ",
    "build:all": "rimraf lib && npm-run-all --parallel prettier:source build:entry build:modules",
    "build:init-entry": "node build/bin/build-entry.js && node build/bin/build-entry-nodejs.js",
    "build:entry": "npm run build:init-entry && cross-env NODE_ENV=production rollup -c build/rollup.entry.js  && terser lib/index.umd.js -m -o lib/index.umd.min.js",
    "build:modules": "cross-env NODE_ENV=production rollup -c build/rollup.modules.js && cross-env NODE_ENV=production rollup -c build/rollup.modules.nodejs.js",
    "build:entry-cdn": "cross-env NODE_ENV=production rollup -c build/rollup.entry-cdn.js && terser lib/index.umd.js -m -o lib/index.umd.min.js",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs && touch docs/.vuepress/compile/fr/@bianpengfei-utils/v3/.spa",
    "docs:deploy": "npm run docs:build && sh docs/bin/deploy.sh",
    "prettier:docs": "prettier 'docs/01.指南/**/*.md' --config --ignore-unknown .prettierrc.js --write",
    "prettier:source": "prettier 'src/**/*.js' --config --ignore-unknown .prettierrc.js --write",
    "prettier:all": "npm run prettier:docs && npm run prettier:source",
    "husky": "husky install && npx husky add .husky/pre-commit 'npx lint-staged'",
    "commitlint": "npx husky add .husky/commit-msg 'npx --no-install commitlint --edit \"$1\"'",
    "build:file-all": "node build/bin/build-entry-all.js",
    "pub:major": "npm version major && npm run pub",
    "pub:minor": "npm version minor && npm run pub",
    "pub:patch": "npm version patch && npm run pub",
    "pub:prepatch": "npm version prepatch && npm run pub",
    "release": "release-it patch",
    "no-pub": "npm run build:all",
    "sh:unpublish": "npm unpublish sf-utils2@3.0.25-beta-3 --force",
    "pub": "npm run no-pub && npm publish --access public"
  },
  "globalName": "sfutils",
  "files": [
    "src",
    "lib",
    "package.json",
    "README.md",
    ".prettierignore",
    ".prettierrc.js",
    "index.d.ts",
    "tsconfig.json",
    "yarn.lock"
  ],
  "keywords": [
    "utils",
    "lazy",
    "dom",
    "data",
    "transform",
    "easy"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/bianpengfei/bianpengfei-utils"
  },
  "dependencies": {
    "clipboard": "2.0.11",
    "dayjs": "1.10.7",
    "decimal.js-light": "2.5.1",
    "deepmerge": "4.2.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --config --ignore-unknown .prettierrc.js --write --no-error-on-unmatched-pattern"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "strict": true,
  "devDependencies": {
    "@babel/core": "7.16.5",
    "@babel/plugin-external-helpers": "7.16.5",
    "@babel/plugin-proposal-object-rest-spread": "7.16.5",
    "@babel/plugin-transform-modules-commonjs": "7.16.5",
    "@babel/plugin-transform-modules-systemjs": "7.16.5",
    "@babel/plugin-transform-modules-umd": "7.16.5",
    "@babel/plugin-transform-runtime": "7.16.5",
    "@babel/preset-env": "7.16.5",
    "@babel/runtime": "7.16.5",
    "@commitlint/cli": "17.3.0",
    "@commitlint/config-conventional": "17.3.0",
    "@release-it/conventional-changelog": "6.0.0",
    "@rollup/plugin-alias": "3.1.9",
    "@rollup/plugin-babel": "5.3.0",
    "@rollup/plugin-commonjs": "21.0.1",
    "@rollup/plugin-json": "4.1.0",
    "@rollup/plugin-node-resolve": "13.1.1",
    "@rollup/plugin-terser": "0.3.0",
    "async-validator": "1.11.5",
    "babel-loader": "8.2.3",
    "babel-plugin-transform-object-assign": "6.22.0",
    "commitlint": "17.3.0",
    "core-js": "3.21.1",
    "cross-env": "7.0.3",
    "crypto-js": "4.1.1",
    "element-ui": "2.15.6",
    "file-saver": "2.0.2",
    "fs-extra": "11.1.0",
    "glob": "7.2.0",
    "gulp": "4.0.2",
    "highlight.js": "11.6.0",
    "html2canvas": "1.4.0",
    "husky": "8.0.2",
    "inquirer": "7.1.0",
    "json-templater": "1.2.0",
    "json2yaml": "1.1.0",
    "jspdf": "2.3.0",
    "jszip": "3.7.1",
    "lint-staged": "13.0.3",
    "lodash": "4.17.21",
    "lodash-es": "4.17.21",
    "npm-run-all": "4.1.5",
    "postcss": "8.4.5",
    "prettier": "2.5.1",
    "regenerator-runtime": "0.13.7",
    "release-it": "16.1.0",
    "rimraf": "2.5.4",
    "rollup": "2.62.0",
    "rollup-plugin-banner": "0.2.1",
    "rollup-plugin-cleanup": "3.2.1",
    "rollup-plugin-dts": "3.0.2",
    "rollup-plugin-livereload": "2.0.5",
    "rollup-plugin-node-externals": "3.1.2",
    "rollup-plugin-serve": "1.1.0",
    "rollup-plugin-visualizer": "5.9.2",
    "shelljs": "0.8.5",
    "vuepress": "1.8.2",
    "vuepress-plugin-cursor-effects": "1.1.2",
    "vuepress-plugin-fulltext-search": "2.2.1",
    "vuepress-plugin-one-click-copy": "1.0.2",
    "vuepress-plugin-ribbon": "1.1.2",
    "vuepress-plugin-thirdparty-search": "1.0.2",
    "vuepress-plugin-zooming": "1.1.8",
    "vuepress-theme-vdoing": "1.12.8",
    "windicss-webpack-plugin": "1.7.3",
    "yamljs": "0.3.0",
    "yargs-parser": "21.1.1"
  },
  "resolutions": {
    "vue-router": "3.5.3",
    "vue": "2.6.14"
  },
  "browserslist": [
    "> 1%",
    "chrome >= 36",
    "last 2 versions",
    "not ie <= 8",
    "iOS >= 6",
    "ie 11",
    "Android > 4.1",
    "Firefox > 20"
  ],
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "release-it": {
    "plugins": {
      "@release-it/conventional-changelog": {
        "header": "# Changelog",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "✨新功能"
            },
            {
              "type": "fix",
              "section": "🐞问题修复"
            },
            {
              "type": "style",
              "section": "🌈样式"
            },
            {
              "type": "docs",
              "section": "📃文档"
            },
            {
              "type": "perf",
              "section": "🎉优化"
            }
          ]
        },
        "infile": "CHANGELOG.md"
      }
    },
    "git": {
      "commitMessage": "chore(release): v${version}",
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": false,
      "draft": false
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "after:bump": "echo 更新版本成功"
    }
  }
}
